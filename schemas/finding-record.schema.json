{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vane.invalid/schemas/finding-record.schema.json",
  "title": "VANE Finding Record",
  "type": "object",
  "required": [
    "finding_id",
    "project_id",
    "title",
    "description",
    "severity",
    "evidence_ids",
    "status"
  ],
  "properties": {
    "finding_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical",
        "unknown"
      ]
    },
    "status": {
      "enum": [
        "DRAFT",
        "TRIAGED",
        "VALIDATED",
        "ACCEPTED",
        "DISPUTED",
        "CLOSED"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "affected_assets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "root_cause": {
      "type": [
        "string",
        "null"
      ]
    },
    "confidence": {
      "type": "string"
    },
    "remediation": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {"enum": ["VALIDATED", "ACCEPTED", "CLOSED"]}
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "evidence_ids": {"minItems": 1}
        }
      }
    }
  ],
  "additionalProperties": false
}
