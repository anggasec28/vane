{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vane.invalid/schemas/asset.schema.json",
  "title": "VANE Asset",
  "type": "object",
  "required": [
    "asset_id",
    "locator",
    "asset_type",
    "disposition"
  ],
  "properties": {
    "asset_id": {
      "type": "string",
      "minLength": 1
    },
    "locator": {
      "type": "string",
      "minLength": 1
    },
    "asset_type": {
      "type": "string",
      "minLength": 1
    },
    "disposition": {
      "enum": [
        "IN_SCOPE",
        "OUT_OF_SCOPE",
        "NOT_INSPECTED",
        "BLOCKED",
        "UNKNOWN"
      ]
    },
    "discovered_from": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
