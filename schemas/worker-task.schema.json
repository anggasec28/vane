{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vane.invalid/schemas/worker-task.schema.json",
  "title": "VANE Worker Task",
  "type": "object",
  "required": [
    "task_id",
    "parent_mission_id",
    "worker_profile",
    "objective",
    "allowed_methods",
    "allowed_asset_ids",
    "deadline",
    "approval_id"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_mission_id": {
      "type": "string",
      "minLength": 1
    },
    "worker_profile": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "allowed_methods": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "allowed_asset_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "approval_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
