{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vane.invalid/schemas/project.schema.json",
  "title": "VANE Project",
  "type": "object",
  "required": [
    "project_id",
    "name",
    "owner",
    "created_at"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
