{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vane.invalid/schemas/approval.schema.json",
  "title": "VANE Approval",
  "type": "object",
  "required": [
    "approval_id",
    "approver",
    "subject_digest",
    "decision",
    "decided_at"
  ],
  "properties": {
    "approval_id": {
      "type": "string",
      "minLength": 1
    },
    "approver": {
      "type": "string",
      "minLength": 1
    },
    "subject_digest": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "decision": {
      "enum": [
        "APPROVE",
        "REJECT"
      ]
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "rationale": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
