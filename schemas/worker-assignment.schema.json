{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$id": "https://vane.invalid/schemas/worker-assignment.schema.json",
  "title": "VANE Worker Assignment",
  "required": [
    "task",
    "status",
    "result",
    "history"
  ],
  "properties": {
    "task": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://vane.invalid/schemas/worker-task.schema.json",
      "title": "VANE Worker Task",
      "type": "object",
      "required": [
        "task_id",
        "parent_mission_id",
        "worker_profile",
        "objective",
        "allowed_methods",
        "allowed_asset_ids",
        "deadline",
        "approval_id"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "parent_mission_id": {
          "type": "string",
          "minLength": 1
        },
        "worker_profile": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "allowed_methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "allowed_asset_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "deadline": {
          "type": "string",
          "format": "date-time"
        },
        "approval_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "DELEGATED",
        "COMPLETED",
        "REVOKED",
        "REJECTED"
      ]
    },
    "result": {
      "type": [
        "object",
        "null"
      ]
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event",
          "worker"
        ],
        "properties": {
          "event": {
            "type": "string",
            "minLength": 1
          },
          "worker": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
