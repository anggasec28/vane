{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$id": "https://vane.invalid/schemas/worker-assignment.schema.json",
  "title": "VANE Worker Assignment",
  "required": [
    "task",
    "status",
    "result",
    "history"
  ],
  "properties": {
    "task": {
      "$ref": "worker-task.schema.json"
    },
    "status": {
      "enum": [
        "DELEGATED",
        "COMPLETED",
        "REVOKED",
        "REJECTED"
      ]
    },
    "result": {
      "type": [
        "object",
        "null"
      ]
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event",
          "worker"
        ],
        "properties": {
          "event": {
            "type": "string",
            "minLength": 1
          },
          "worker": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
