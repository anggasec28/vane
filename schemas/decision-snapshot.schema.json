{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vane.invalid/schemas/decision-snapshot.schema.json",
  "title": "VANE Central Decision Snapshot",
  "type": "object",
  "required": [
    "decision_id",
    "project_id",
    "revision",
    "status",
    "title",
    "rationale",
    "actor",
    "authority_reference",
    "trigger",
    "occurred_at",
    "evidence_references",
    "dependency_decision_ids",
    "policy_version",
    "uncertainty"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "VALID",
        "REVALIDATION_REQUIRED",
        "SUSPENDED",
        "SUPERSEDED",
        "UNRESOLVED"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "authority_reference": {
      "type": "string",
      "minLength": 1
    },
    "trigger": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "dependency_decision_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "superseded_by_decision_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "superseded_by_revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "uncertainty": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "SUPERSEDED"
          }
        }
      },
      "then": {
        "required": [
          "superseded_by_decision_id",
          "superseded_by_revision"
        ],
        "properties": {
          "superseded_by_decision_id": {
            "type": "string",
            "minLength": 1
          },
          "superseded_by_revision": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
