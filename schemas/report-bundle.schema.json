{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$id": "https://vane.invalid/schemas/report-bundle.schema.json",
  "title": "VANE Assessment Report Bundle",
  "required": [
    "report_id",
    "generated_at",
    "executive_summary",
    "mission",
    "findings",
    "evidence_index",
    "limitations",
    "unresolved_blockers"
  ],
  "properties": {
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "executive_summary": {
      "type": "string"
    },
    "mission": {
      "type": "object",
      "required": [
        "mission_id",
        "project_id",
        "objective",
        "status",
        "required_evidence",
        "completed_evidence"
      ],
      "properties": {
        "mission_id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "required_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "completed_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence_index": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unresolved_blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
