{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vane.invalid/schemas/authorization-envelope.schema.json",
  "title": "VANE Authorization Envelope",
  "type": "object",
  "required": ["envelope_id", "principal", "project_id", "rules", "allowed_methods", "starts_at", "expires_at", "approval_id"],
  "properties": {
    "envelope_id": {"type": "string", "minLength": 1},
    "principal": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "rules": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["kind", "value"], "properties": {"kind": {"enum": ["hostname", "url", "ip", "cidr", "contract", "repository"]}, "value": {"type": "string", "minLength": 1}, "include_subdomains": {"type": "boolean"}, "ports": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 65535}}, "notes": {"type": "string"}}, "additionalProperties": false}},
    "allowed_methods": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "prohibited_methods": {"type": "array", "items": {"type": "string"}},
    "starts_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "approval_id": {"type": "string", "minLength": 1},
    "revoked": {"type": "boolean"}
  },
  "additionalProperties": false
}
