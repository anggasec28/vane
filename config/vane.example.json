{
  "profile": "vane",
  "runtime": "hermes-agent",
  "mode": "autonomous_with_approval",
  "storage": {
    "backend": "sqlite",
    "path": "./data/vane.sqlite3"
  },
  "policy": {
    "default_decision": "deny",
    "require_authorization_envelope": true,
    "require_explicit_method_allowlist": true,
    "scope_expansion": "deny_without_master_approval",
    "unknown_asset_disposition": "not_inspected",
    "require_evidence_for_finding_validation": true,
    "high_risk_methods": [
      "active_scan",
      "exploit_validation",
      "credential_test",
      "transaction_submit",
      "state_change",
      "data_export",
      "destructive_action"
    ]
  },
  "mcp": {
    "default_enabled": false,
    "require_capability_registration": true
  },
  "signing": {
    "algorithm": "Ed25519",
    "provider": "external_signing_service",
    "private_key_in_engine": false
  },
  "runtime_integration": {
    "enabled": false,
    "mutate_hermes": false
  },
  "production": {
    "authorized": false
  },
  "approval_verification": {
    "algorithm": "Ed25519",
    "public_keyring_path": "./config/approval-public-keys.json",
    "fail_closed_if_unavailable": true
  }
}
